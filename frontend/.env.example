# Base URL the frontend uses for backend calls. Default "/api" is proxied to
# VITE_API_PROXY by the Vite dev server (see vite.config.ts). Set this to an
# absolute URL when the frontend is served separately from the backend.
VITE_API_BASE_URL=/api

# Where `npm run dev` forwards `/api` requests. Match the backend's host:port.
VITE_API_PROXY=http://127.0.0.1:8000
