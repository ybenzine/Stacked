# Deployment environment name: development | test | production
STACKED_ENV=development

# Expose POST /api/reset (wipes all data and reseeds). Keep false in production.
STACKED_EXPOSE_DEV_RESET=true

# Database connection as a SQLAlchemy URL. Defaults to a local SQLite file;
# point it at another database later (e.g. postgresql+psycopg://user:pass@host/db).
STACKED_DATABASE_URL=sqlite:///./stacked.db
